# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id

# Supabase MCP Server Configuration (Solo para desarrollo local con Copilot)
# Get your token at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_your_access_token_here

# Guarnold Brand Footer Configuration
# Reusable across all Guarnold projects - customize for each app
VITE_APP_NAME=Your App Name
VITE_APP_VERSION=1.0.0
VITE_BRAND_NAME=Guarnold
VITE_BRAND_URL=https://guarnold.com.ar
VITE_REPO_URL=https://github.com/your-username/your-repo
