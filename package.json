{
  "name": "guarnold-portfolio",
  "screenName": "Guarnold Portfolio",
  "description": "Sitio personal de Guarnold: portfolio (/), CV público (/cv) y editor del CV (/admin).",
  "private": true,
  "version": "2026.10.09-b29",
  "type": "module",
  "gitURL": "https://github.com/Facundo-Guarnier/guarnold-portfolio",
  "scripts": {
    "dev": "vite",
    "dev:docker": "vite --mode docker",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integracion": "vitest run -c vitest.integracion.config.ts",
    "test:sql": "node tools/local/test-sql.mjs",
    "test:e2e": "playwright test",
    "db:local": "node tools/local/preparar-stack.mjs",
    "db:local:reset": "node tools/local/preparar-stack.mjs --reset",
    "db:local:parar": "supabase stop",
    "deploy:plan": "node tools/deploy/desplegar-supabase.mjs --plan",
    "verificar:headers": "node tools/headers/verificar-headers.mjs"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.3.0",
    "@supabase/supabase-js": "^2.89.0",
    "@tanstack/react-query": "^5.90.12",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@rollup/plugin-yaml": "^4.1.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.19",
    "jsdom": "^27.4.0",
    "lovable-tagger": "^1.1.13",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.3",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
