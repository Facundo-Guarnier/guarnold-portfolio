{
  "name": "guarnold-portfolio",
  "screenName": "Guarnold Portfolio",
  "description": "Sitio personal de Guarnold: portfolio (/), CV público (/cv) y editor del CV (/admin).",
  "private": true,
  "version": "2026.11.01-b40",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.4.2",
  "type": "module",
  "gitURL": "https://github.com/Facundo-Guarnier/guarnold-portfolio",
  "scripts": {
    "dev": "vite",
    "dev:cuenta": "vite --mode cuentalocal",
    "dev:docker": "vite --mode docker",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integracion": "vitest run -c vitest.integracion.config.ts",
    "test:sql": "node tools/local/test-sql.mjs",
    "test:e2e": "playwright test",
    "db:local": "node tools/local/preparar-stack.mjs",
    "db:local:reset": "node tools/local/preparar-stack.mjs --reset",
    "db:local:parar": "supabase stop",
    "deploy:plan": "node tools/deploy/desplegar-supabase.mjs --plan",
    "verificar:headers": "node tools/headers/verificar-headers.mjs",
    "prepare": "husky",
    "totp:local": "node tools/local/codigo-totp.mjs"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@rollup/plugin-yaml": "^5.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.19",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lovable-tagger": "^1.1.13",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
