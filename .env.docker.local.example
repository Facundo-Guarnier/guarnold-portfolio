# Plantilla de `.env.docker.local` (modo `docker`: `npm run dev:docker`, el stack Docker de este repo).
# ⊥ hace falta copiarla a mano: `npm run db:local` escribe el archivo real con las claves del stack
# levantado. Se commitea solo esta plantilla; `.env.docker.local` está gitignoreado (`.env.*.local`).
#
# Vite carga `.env.docker.local` SOLO en el modo `docker`: `npm run dev` y el build siguen usando `.env`
# (la nube). Por eso el nombre es ese y ⊥ `.env.local`, que Vite cargaría en TODOS los modos.

# Puerto del stack local: supabase/config.toml (bloque 54380-54389, ver AGENTS.md).
VITE_SUPABASE_URL=http://127.0.0.1:54381
# Clave anónima de la instancia local (`supabase status -o env`). Pública por diseño, pero es de la
# base local: ⊥ es la de la nube.
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_SCHEMA=cv-formatter
# Vacío = login propio contra el stack local (⊥ Guarnold ID).
VITE_CUENTA_URL=
